{
  "name": "studiovd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check:offline": "node tools/offline/scanBundle.mjs dist",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "notices": "node tools/notices/generate.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@react-three/rapier": "2.2.0",
    "@tauri-apps/api": "^2",
    "@xyflow/react": "12.12.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "immer": "11.1.21",
    "lucide-react": "1.55.0",
    "occt-import-js": "0.0.23",
    "radix-ui": "1.7.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-resizable-panels": "4.14.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1",
    "three-mesh-bvh": "0.8.3",
    "zod": "4.6.5",
    "zundo": "2.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.0.16",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@dimforge/rapier3d-compat": "$@dimforge/rapier3d-compat",
    "three": "$three"
  }
}
