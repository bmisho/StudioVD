{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: exactly what the UI uses (PLAN 15.2). Events for project prompts and drops, closing the window, and the app's own commands; no asset protocol, no fs/http/shell plugins (dialogs run in Rust).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-app-info",
    "allow-log-webview-error",
    "allow-project-info",
    "allow-project-new",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-open-launch",
    "allow-project-pending-scene",
    "allow-project-commit",
    "allow-project-discard",
    "allow-project-pick-save-path",
    "allow-project-save",
    "allow-project-set-dirty",
    "allow-project-close-ack",
    "allow-project-close-confirmed",
    "allow-recent-projects",
    "allow-autosave-write",
    "allow-autosave-clear",
    "allow-recovery-list",
    "allow-recovery-restore",
    "allow-recovery-discard",
    "allow-pick-import-files",
    "allow-read-import-file",
    "allow-read-import-resource",
    "allow-import-texture",
    "allow-write-asset",
    "allow-pick-export-path",
    "allow-write-export",
    "allow-write-export-credits",
    "allow-decompose-mesh",
    "allow-library-list",
    "allow-library-pick-pack",
    "allow-library-install-commit",
    "allow-library-install-cancel",
    "allow-library-remove",
    "allow-library-copy-into-project",
    "allow-library-user-namespace",
    "allow-library-project-geometry-sizes",
    "allow-library-add-from-project",
    "allow-library-export-pack",
    "allow-catalog-status",
    "allow-catalog-refresh",
    "allow-catalog-download",
    "allow-catalog-cancel",
    "allow-library-disk-usage",
    "allow-network-settings",
    "allow-network-save",
    "allow-network-pick-ca",
    "allow-network-clear-ca",
    "allow-network-test"
  ]
}
