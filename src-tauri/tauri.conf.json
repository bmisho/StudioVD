{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioVD",
  "version": "0.1.0",
  "identifier": "com.studiovd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StudioVD",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "stvd"
        ],
        "name": "StudioVD.Project",
        "description": "StudioVD project",
        "mimeType": "application/x-studiovd",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/studiovd.xml": "bundle/linux/studiovd-mime.xml"
        },
        "desktopTemplate": "bundle/linux/studiovd.desktop"
      },
      "rpm": {
        "files": {
          "/usr/share/mime/packages/studiovd.xml": "bundle/linux/studiovd-mime.xml"
        },
        "desktopTemplate": "bundle/linux/studiovd.desktop"
      }
    }
  }
}
