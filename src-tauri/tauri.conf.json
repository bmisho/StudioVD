{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StudioVD",
  "version": "0.2.0",
  "identifier": "com.studiovd.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StudioVD",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: stvd: http://stvd.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost stvd: http://stvd.localhost blob: data:",
        "media-src": "'none'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "stvd"
        ],
        "name": "StudioVD.Project",
        "description": "StudioVD project",
        "mimeType": "application/x-studiovd",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/studiovd.xml": "bundle/linux/studiovd-mime.xml"
        },
        "desktopTemplate": "bundle/linux/studiovd.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "StudioVD",
    "category": "GraphicsAndDesign",
    "shortDescription": "3D CAD assembly visualizer and multi-domain simulator",
    "longDescription": "Import CAD parts, apply materials, mate them with mechanical constraints, test the mechanism and map its electrical, mechanical, fluid and light behaviour in a live schematic.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
